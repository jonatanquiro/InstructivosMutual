# Copiar este archivo a ".env" y completar con los valores reales.
# El archivo ".env" NUNCA se sube a git (ver .gitignore).
#
# Para levantar una instancia de TESTEO en paralelo a producción (por
# ejemplo en el puerto 3001, contra una base de datos separada), copiar
# este archivo a ".env.test" con esos valores distintos y correr
# "npm run dev:test" (usa ENV_FILE=.env.test, ver package.json).

# --- SQL Server ---
DB_SERVER=localhost
DB_DATABASE=INFORMA
DB_USER=
DB_PASSWORD=
DB_PORT=1433
# true si el certificado del server es autofirmado (típico en LAN interna)
DB_TRUST_SERVER_CERT=true

# --- SQL Server: base DW (estadísticas de socios para "Proyectos") ---
# Idealmente un usuario de SOLO LECTURA (db_datareader), nunca el admin/sa.
DW_DB_SERVER=
DW_DB_DATABASE=
DW_DB_USER=
DW_DB_PASSWORD=
DW_DB_PORT=1433
DW_DB_TRUST_SERVER_CERT=true

# --- Servidor web ---
PORT=3000
# Cadena random usada para firmar la cookie de sesión. Cualquier texto largo
# y difícil de adivinar sirve. Generar una propia para producción.
SESSION_SECRET=cambiar-esto-por-algo-random-y-largo

# Clave para cifrar el texto de los mensajes del chat (AES-256-GCM). Tiene
# que ser un hex de 64 caracteres (32 bytes). Generar una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# No cambiarla una vez que haya mensajes guardados: los mensajes viejos
# quedan ilegibles si se pierde o se reemplaza la clave.
CHAT_CLAVE_CIFRADO=

# --- Opcionales, solo hacen falta para correr una instancia de TESTEO en
# paralelo a producción sin que se pisen (ver .env.test más arriba) ---
# Nombre de cookie de sesión distinto al de producción (si no se pone, usa
# el default "connect.sid" — mismo nombre en las dos instancias haría que
# loguearte en una cierre la sesión de la otra, si las probás en el mismo
# navegador).
SESSION_COOKIE_NAME=
# Carpeta (relativa a src/) donde se guardan las imágenes del chat, para no
# mezclar los adjuntos de testeo con los de producción.
CHAT_UPLOADS_DIR=
